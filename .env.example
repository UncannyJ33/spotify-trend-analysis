# Copy to `.env` and fill in. `.env` is gitignored; this template is not.
#
# Optional. Only used by Stage 2 as a fallback, to attach genres to artists
# MusicBrainz resolved but has no tags for. The pipeline runs fine without it.
#
# Create an app at https://developer.spotify.com/dashboard
#   Redirect URI : http://127.0.0.1:3000   (unused by the Client Credentials
#                  flow, but Spotify rejects `localhost` — use the literal IP)
#   API/SDKs     : Web API only

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional path overrides, if the export lives outside the project directory.
# SPOTIFY_EXPORT_DIR=/path/to/Spotify Extended Streaming History
# SPOTIFY_DATA_DIR=/path/to/data
