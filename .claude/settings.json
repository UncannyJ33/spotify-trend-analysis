{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Bash(cat ./.env)",
      "Bash(cat .env)",
      "Bash(less .env)",
      "Bash(head .env)",
      "Bash(tail .env)",
      "Bash(grep * .env)",
      "Bash(env)",
      "Bash(printenv)"
    ]
  }
}
